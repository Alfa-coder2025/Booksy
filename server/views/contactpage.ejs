<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Online Bookstore</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/app.css" rel="stylesheet" type="text/css" />
  
</head>
<body>

<!--navbar(to be imported)-->

<%- include('navbar') %>

  <main>
    <div class="container contact-section">
      <!-- Breadcrumb -->
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="#">Home</a></li>
          <li class="breadcrumb-item active" aria-current="page">Contact</li>
        </ol>
      </nav>

      <!-- Contact Cards -->
      <div class="row mb-5">
        <div class="col-md-6 mb-4 mb-md-0">
          <div class="contact-card">
            <div class="contact-icon">
              <i class="fas fa-phone"></i>
            </div>
            <h3>Call Us</h3>
            <p class="text-muted">We are available from 8:00 - 17:00 Sunday to Friday.</p>
            <p class="fw-bold">Phone: +880181112222</p>
          </div>
        </div>
        <div class="col-md-6">
          <div class="contact-card">
            <div class="contact-icon">
              <i class="fas fa-envelope"></i>
            </div>
            <h3>Write To US</h3>
            <p class="text-muted">Fill out our form and we will contact you within 24 hours.</p>
            <p class="fw-bold">Emails: customer@exclusive.com</p>
            <p class="fw-bold">Emails: support@exclusive.com</p>
          </div>
        </div>
      </div>
      
      <!-- Contact Form -->
      <div class="row">
        <div class="col-lg-12">
          <div class="contact-form">
            <h3 class="mb-4">Send us a message</h3>
            <form>
              <div class="row">
                <div class="col-md-4">
                  <input type="text" class="form-control" placeholder="Your Name *" required>
                </div>
                <div class="col-md-4">
                  <input type="email" class="form-control" placeholder="Your Email *" required>
                </div>
                <div class="col-md-4">
                  <input type="tel" class="form-control" placeholder="Your Phone *" required>
                </div>
              </div>
              <div class="row">
                <div class="col-12">
                  <textarea class="form-control" rows="5" placeholder="Your Message"></textarea>
                </div>
              </div>
              <button type="submit" class="btn btn-send">Send Message</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </main>


  <!--  Footer (to be imported) -->
   <%- include('footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
