
<!DOCTYPE html>
<html lang="en">
<head>
  <head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Users</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/admin.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  
  
</head>
<body>
  <div class="d-flex">
    <!-- Sidebar -->
    <%- include("sidebar") %>

    <!-- Main Content -->
    <div class="content-area p-4 flex-grow-1">
      <!-- Search Bar -->
      <div class="mb-4">
        <input type="text" class="form-control w-50" placeholder="🔍 Search">
      </div>

      <!-- Add Offer Form -->
      <div class="card shadow-sm mb-4">
        <div class="card-body">
          <h5 class="mb-3">Add Offer</h5>
          <form action="/offers/add" method="POST">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Title</label>
                <input type="text" name="title" class="form-control" placeholder="Enter offer title">
              </div>
              <div class="col-md-6">
                <label class="form-label">Description</label>
                <input type="text" name="description" class="form-control" placeholder="Enter description">
              </div>
              <div class="col-md-4">
                <label class="form-label">Discount Value</label>
                <input type="number" name="discountValue" class="form-control" placeholder="e.g. 200">
              </div>
              <div class="col-md-4">
                <label class="form-label">Minimum Order Value</label>
                <input type="number" name="minOrderValue" class="form-control" placeholder="e.g. 500">
              </div>
              <div class="col-md-4">
                <label class="form-label">Usage Limit</label>
                <input type="number" name="usageLimit" class="form-control" placeholder="e.g. 1">
              </div>
              <div class="col-md-4">
                <label class="form-label">End Date</label>
                <input type="date" name="endDate" class="form-control">
              </div>
            </div>
            <div class="mt-3">
              <button type="submit" class="btn btn-primary">Add Offer</button>
            </div>
          </form>
        </div>
      </div>

      <!-- Offers Table -->
      <div class="card shadow-sm">
        <div class="card-body">
          <h5 class="mb-3">Offers List</h5>
          <div class="table-responsive">
            <table class="table table-bordered align-middle">
              <thead class="table-light">
                <tr>
                  <th>Title</th>
                  <th>Minimum Order Value</th>
                  <th>Discount Value</th>
                  <th>Description</th>
                  <th>Usage Limit</th>
                  <th>Expiry Date</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody id="offerTableBody">
                <tr>
                  <td colspan="7" class="text-center">No offers available.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div> <!-- end content-area -->
  </div> <!-- end d-flex -->
</body>

