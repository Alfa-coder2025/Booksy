<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Account - Book Store</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="/css/app.css" rel="stylesheet" type="text/css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
  <script src="/js/main/useraccount.js"></script>
</head>
<body>
  <!-- Navbar -->
  <%- include('navbar') %>

  <!-- Breadcrumb -->
  <div class="container mt-3">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/landingpage">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">My Account</li>
      </ol>
    </nav>
  </div>

  <!-- Account Section -->
  <div class="container my-4">
    <div class="row">
      <!-- Sidebar -->
      <div class="col-md-3">
        <div class="card p-3 shadow-sm">
          <div class="text-center">
            <img id="sidebarProfileImage" class="rounded-circle mb-2" name="profilePic" alt="Profile">
            <h6 id="sidebarUserName"></h6>
          </div>
          <hr>
          <ul class="nav flex-column">
            <li class="nav-item"><a class="nav-link" href="#">Manage My Account</a></li>
            <li class="nav-item ps-3">
              <a class="nav-link small text-muted" href="#" data-bs-toggle="modal" data-bs-target="#profileModal">
                My Profile
              </a>
            </li>
            <li class="nav-item ps-3"><a class="nav-link small text-muted" href="#">Address Book</a></li>
            <li class="nav-item"><a class="nav-link" href="#">Wallet</a></li>
            <li class="nav-item"><a class="nav-link" href="#">Coupons</a></li>
          </ul>
        </div>
      </div>

      <!-- Main Content -->
      <div class="col-md-9">
        <div class="text-center mb-4">
          <h3>Welcome! <span id="welcomeUserName"></span></h3>
        </div>
        <div class="row text-center g-4">
          <!-- Orders -->
          <div class="col-md-6">
            <div class="p-4 border rounded shadow-sm position-relative">
              <i class="bi bi-card-list display-3"></i>
              <span id="ordersCount" class="badge bg-danger position-absolute top-0 start-50 translate-middle"></span>
              <h5 class="mt-3">Orders</h5>
            </div>
          </div>
          <!-- Wishlist -->
          <div class="col-md-6">
            <div class="p-4 border rounded shadow-sm position-relative">
              <i class="bi bi-heart display-3"></i>
              <span id="wishlistCount" class="badge bg-dark position-absolute top-0 start-50 translate-middle"></span>
              <h5 class="mt-3">Wishlist</h5>
            </div>
          </div>
        </div>

        <!-- Change Password -->
        <div class="text-center mt-5">
          <a href="#" class="text-decoration-none">
            <i class="bi bi-lock display-6"></i>
            <div>Change Password</div>
          </a>
        </div>
      </div>
    </div>
  </div>
  

<!-- Profile Modal -->
<div class="modal fade" id="profileModal" tabindex="-1" aria-labelledby="profileModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content rounded-3 shadow">

      <!-- Header -->
      <div class="modal-header bg-light">
        <h5 class="modal-title" id="profileModalLabel">My Profile</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <!-- Body -->
      <div class="modal-body">
        <div class="row">
          
          <!-- Left: Profile Image -->
          <div class="col-md-4 text-center">
            <img id="profileImage" src="https://via.placeholder.com/150" alt="Profile"
                 class="rounded-circle img-thumbnail mb-3" style="width: 150px; height: 150px; object-fit: cover;">
            
            <!-- Upload New Image -->
            <form>
              <div class="mb-3">
                <label for="profilePicUpload" class="form-label small">Upload New Profile Picture</label>
                <input class="form-control" type="file" id="profilePicUpload" name="profilePic" accept="image/*">
              </div>
              <button class="btn btn-sm btn-primary">Save Picture</button>
            </form>
          </div>

          <!-- Right: User Details -->
          <div class="col-md-8">
            <h6 class="fw-bold">Personal Information</h6>
            
            <p>
              <strong>Name:</strong> <span id="userName"></span>
              <i class="bi bi-pencil-square edit-icon ms-2" title="Edit Name"></i>
            </p>
            <p>
              <strong>Contact Number:</strong> <span id="userPhone"></span>
              <i class="bi bi-pencil-square edit-icon ms-2" title="Edit Contact Number"></i>
            </p>
            <p>
              <strong>Alternate Number:</strong> <span id="userAltPhone"></span>
              <i class="bi bi-pencil-square edit-icon ms-2" title="Edit Alternate Number"></i>
            </p>
            <p>
              <strong>Email:</strong> <span id="userEmail"></span>
              <i class="bi bi-pencil-square edit-icon ms-2" title="Edit Email"></i>
            </p>

            <hr>
            <h6 class="fw-bold">Address</h6>
            <p id="userAddress"></p>
            <i class="bi bi-pencil-square edit-icon ms-2" title="Edit Address"></i>
          </div>
        </div>
      </div>

      <!-- Footer -->
      <div class="modal-footer">
        <button type="button" class="btn btn-dark" data-bs-dismiss="modal">Close</button>
      </div>

    </div>
  </div>
</div>


  <!-- Footer -->
  <%- include('footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
