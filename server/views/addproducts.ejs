
<!DOCTYPE html>
<html lang="en">
<head>
  <head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Users</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/admin.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <script type="module" src="/js/main/adminaddproducts.js"></script>

</head>

<body>
 <div class="container-fluid">
  <div class="row">
    <!-- Sidebar -->
    <div class="col-md-2 p-0">
      <%- include('sidebar') %>
    </div>

    <!-- Main Content -->
    <div class="col-md-10 content-area">
      <!-- Top bar -->
      <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
        <h2 class="fw-bold mb-0">Add new</h2>
        <div class="search-box">
          <input type="text" class="form-control" placeholder="Search">
        </div>
      </div>

      <!-- Form section -->
      <div class="main-content py-4">
        <form id="add-product-form" enctype="multipart/form-data">
          <div class="row g-5">
            <!-- Left side -->
            <div class="col-md-7">
              <div class="mb-3">
                <label class="form-label fw-bold">Product Name</label>
                <input type="text" class="form-control" placeholder="Type name here" name="bookName"id="bookName">
              </div>
              <div class="mb-3">
  <label class="form-label fw-bold">ISBN</label>
  <input type="text" class="form-control" placeholder="Enter ISBN number" name="ISBN" id="ISBN">
</div>

               <!-- Author Dropdown -->
           <div class="mb-3">
          <label class="form-label fw-bold">Author</label>
        <select class="form-select" name="authorId" id="authorDropdown">
         <option value="">Select an Author</option>
        </select>
         </div>

              <div class="mb-3">
                <label class="form-label fw-bold">Description</label>
                <textarea class="form-control" rows="4" placeholder="Type description" name="description" id="description"></textarea>
              </div>

              <!-- Publisher -->
<div class="mb-3">
  <label class="form-label fw-bold">Publisher</label>
  <input type="text" class="form-control" placeholder="Enter publisher name" name="publisher" id="publisher">
</div>

<!-- Published Date -->
<div class="mb-3">
  <label class="form-label fw-bold">Published Date</label>
  <input type="date" class="form-control" name="publishedDate" id="publishedDate">
</div>

<!-- Total Pages -->
<div class="mb-3">
  <label class="form-label fw-bold">Total Pages</label>
  <input type="number" class="form-control" placeholder="Enter total pages" name="totalPage" id="totalPage">
</div>

<!-- Cover Type -->
<div class="mb-3">
  <label class="form-label fw-bold">Cover Type</label>
  <select class="form-select" name="coverType" id="coverType">
    <option value="">Select Cover Type</option>
    <option value="Hardcover">Hardcover</option>
    <option value="Paperback">Paperback</option>
  </select>
</div>

<!-- Language -->
<div class="mb-3">
  <label class="form-label fw-bold">Language</label>
  <input type="text" class="form-control" placeholder="Enter book language" name="language" id="language">
</div>

              <div class="mb-3">
                <label class="form-label fw-bold">Offer</label>
                <input type="text" class="form-control" placeholder="Type here" name="offer" id="offer" >
              </div>
              <div class="mb-3">
                <label class="form-label fw-bold">Stock Quantity</label>
                <input type="number" class="form-control" placeholder="Enter quantity" name="stockQuantity" id="stockQuantity">
              </div>
              <div class="row mb-3">
                <div class="col">
                  <label class="form-label fw-bold">Regular Price</label>
                  <input type="text" class="form-control" placeholder="₹ 999" name="regularPrice" id="regularPrice">
                </div>
                <div class="col">
                  <label class="form-label fw-bold">Sale Price</label>
                  <input type="text" class="form-control" placeholder="₹ 599" name="salePrice" id="salePrice">
                </div>
              </div>

                <div class="row mb-3">
  <div class="col">
    <label for="showAsTopSelling" class="form-label fw-bold">Show as Top Selling</label>
    <div class="form-check form-switch">
     <!---
      <input type="hidden" name="showAsTopSelling" value="false">
    -->
      <input class="form-check-input" type="checkbox" id="showAsTopSelling" name="showAsTopSelling">
      <label class="form-check-label" for="showAsTopSelling"></label>
    </div>
  </div>

  <div class="col">
    <label for="showAsLatest" class="form-label fw-bold">Show as Latest</label>
    <div class="form-check form-switch">
      <!---
      <input type="hidden" name="showAsLatest">
    -->
      <input class="form-check-input" type="checkbox" id="showAsLatest" name="showAsLatest">
      <label class="form-check-label" for="showAsLatest"></label>
    </div>
  </div>
</div>

              <!--add drop down for category-->
              <div class="mb-4">
  <label class="form-label fw-bold">Category</label>
  <select class="form-select" name="categoryId" id="categoryDropdown">
    <option value="">Select a Category</option>
  </select>
</div>

               <div class="mb-3">
    <label class="form-label fw-bold">Book Cover</label>
    <input type="file" name="image" id="bookCover" class="form-control" accept="image/*" >
  </div>

              <div class="d-flex gap-3">
                <button type="button" class="btn btn-outline-primary btn-lg" id="close-btn">
                  Close <i class="bi bi-plus"></i>
                </button>
                <button type="submit" class="btn btn-primary btn-lg">ADD PRODUCT</button>
              </div>
            </div>
 
            <!-- Right side -->
            <div class="col-md-5">
              <div class="card shadow-sm border-0 p-3 text-center">
                <img src="/images/book-cover.png" class="img-fluid rounded" alt="Book Cover">
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

  
</body>
</html>