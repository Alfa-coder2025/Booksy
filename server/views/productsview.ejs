<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Book Store</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="/css/app.css" rel="stylesheet" type="text/css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
  <script src="/js/main/productsview.js"></script>
  </head>
  <body>
   <!-- Navbar -->

<%- include('navbar') %>

<!--breadcrumbs-->
<ol class="breadcrumb">
  <li class="breadcrumb-item">
    <a href="/landingpage" id="homeBreadcrumb">Home</a>
  </li>
  <li class="breadcrumb-item">
    <a href="/user-productslisting" id="productsBreadcrumb">Products</a>
  </li>
  <li class="breadcrumb-item active" aria-current="page" id="bookNameBreadcrumb">
    <!-- book name will be injected -->
  </li>
</ol>


  <!-- Book Details Section -->
  <div class="container my-5">
    <div class="row">
      <!-- Left Column: Book Images -->
      <div class="col-md-5">
        <!-- Book Cover Image (Dynamic) -->
        <div class="mb-3">
          <img id="bookMainImage" src="" class="img-fluid rounded shadow-sm" alt="Book Cover">
        </div>
         <div>
          <img id="bookImage" src="" class="img-fluid rounded shadow-sm" alt="bookImage">
        </div>
        <!-- Author Image (Dynamic) -->
        <div>
          <img id="authorImage" src="" class="img-fluid rounded shadow-sm" alt="Author Image">
        </div>
        
      </div>

      <!-- Right Column: Book Info -->
      <div class="col-md-7">
        <!-- Book Title (Dynamic) -->
        <h3 id="bookTitle"></h3>

        <!-- Author Name (Dynamic) -->
        <p class="text-muted" id="bookAuthor"></p>

        <!-- Rating + Review Count (Dynamic) -->
        <p><span class="text-warning" id="bookRating"></span></p>

        <!-- Pages / Language / Published Date (Dynamic) -->
        <p id="bookMeta"></p>

        <!-- ISBN (Dynamic) -->
        <p id="bookISBN"></p>

        <!-- Price (Dynamic) -->
        <h4 class="text-primary">
          <span id="bookPrice"></span>
          <small class="text-muted text-decoration-line-through" id="bookOldPrice"></small>
        </h4>

          <!-- Stock Dynamic -->

        <p id="stockQuantity"></p>

       <!-- short description
        <p id="bookDescription"></p> -->



        <!-- Quantity + Add to Cart -->
        <div class="d-flex align-items-center mb-3">
          <div class="input-group me-3" style="width:120px;">
            <button class="btn btn-outline-secondary" id="qtyMinus">-</button>
            <input type="text" class="form-control text-center" id="qtyInput" value="1">
            <button class="btn btn-outline-secondary" id="qtyPlus">+</button>
          </div>
          <button class="btn btn-primary me-2" id="addToCartBtn">Add to Cart</button>
          <button class="btn btn-warning" id="buyNowBtn">Buy Now</button>
        </div>

        <!-- Delivery & Return Info -->
        <ul class="list-unstyled">
          <li><i class="bi bi-truck"></i> <span id="deliveryInfo">Free Delivery</span></li>
          <li><i class="bi bi-arrow-repeat"></i> <span id="returnInfo">Free 30-Day Return Policy</span></li>
        </ul>
      </div>
    </div>

    <!-- Tabs for Description / Reviews -->
    <ul class="nav nav-tabs mt-5" id="bookTab" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active" id="desc-tab" data-bs-toggle="tab" data-bs-target="#desc" type="button" role="tab">Description</button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews" type="button" role="tab">Reviews</button>
      </li>
    </ul>
    <div class="tab-content border p-4" id="bookTabContent">

        <h5 class="mt-4">Short Summary</h5>
        <p id="bookSummary">
          <!--dynamically added-->
        </p>
      </div>
      <div class="tab-pane fade" id="reviews" role="tabpanel">
        <div id="reviewsList">
          <p>⭐️⭐️⭐️⭐️⭐️ - "A timeless classic!"</p>
          <p>⭐️⭐️⭐️⭐️ - "Chilling and atmospheric."</p>
          <p>⭐️⭐️⭐️ - "A bit slow but worth the read."</p>
        </div>
      </div>
    </div>

    <!-- Related Items -->
    <!-- <h4 class="mt-5">Related Items</h4>
    <div class="row row-cols-2 row-cols-md-5 g-3" id="relatedItems">
      <div class="col">
        <div class="card h-100">
          <img src="/assets/images/alchemist.jpg" class="card-img-top" alt="The Alchemist">
          <div class="card-body text-center">
            <p class="mb-1 fw-bold">The Alchemist</p>
            <p class="text-primary">₹359</p>
          </div>
        </div>
      </div> -->

      <!-- Related Items -->
<h4 class="mt-5">Related Items</h4>
<div class="row row-cols-2 row-cols-md-5 g-3" id="relatedItems">
  <!-- Related items will be dynamically loaded here -->
</div>
      
      
      
    
  </div>

  
  </body>
  </html>