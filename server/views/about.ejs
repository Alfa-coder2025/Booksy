<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Online Bookstore</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/app.css" rel="stylesheet" type="text/css" />
  
</head>
<body>

  <!--navbar(to be imported)-->

<%- include('navbar') %>

<main>
  <div class="container about-section py-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/landingpage">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">About</li>
      </ol>
    </nav>

    <!-- About Content -->
    <div class="row align-items-center mb-5">
      <!-- Left Column: Text -->
      <div class="col-lg-6">
        <h1 class="mb-4">About Us</h1>
        <h3>📚 Welcome to Booksy!</h3>
        <p>
          At Booksy, we believe that every book opens a door to a new world.
          Founded with a passion for reading and a vision to make quality books
          accessible to all, Booksy is your one-stop online bookstore for
          bestselling titles, timeless classics, and hidden gems across all
          genres.
        </p>
        <p>
          Whether you're a student, a book lover, or someone just starting their
          reading journey, Booksy offers a carefully curated collection to
          inspire, inform, and entertain. From fiction to self-help, from
          thrillers to academic texts – we've got something for every reader.
        </p>

        <h4 class="mt-4">We aim to provide:</h4>
        <ul>
          <li>🚚 Fast and reliable delivery</li>
          <li>💰 Affordable prices and regular discounts</li>
          <li>🤝 Hassle-free returns and friendly support</li>
        </ul>
        <p class="fw-bold mt-4">Discover the joy of Reading with Booksy!!</p>
      </div>

      <!-- Right Column: Image -->
      <div class="col-lg-6 text-center">
        
        <img src="/uploads/about.webp" alt="Bookstore" class="img-fluid rounded shadow">

      </div>
    </div>

    <!-- Stats Section -->
    <div class="row text-center mb-5">
      <div class="col-md-3 col-6 mb-4">
        <div class="p-4 border rounded shadow-sm">
          <h3 class="fw-bold">5.5k</h3>
          <p>Sellers active our site</p>
        </div>
      </div>
      <div class="col-md-3 col-6 mb-4">
        <div class="p-4 border rounded shadow-sm bg-primary text-white">
          <h3 class="fw-bold">10k</h3>
          <p>Monthly Product Sale</p>
        </div>
      </div>
      <div class="col-md-3 col-6 mb-4">
        <div class="p-4 border rounded shadow-sm">
          <h3 class="fw-bold">15.5k</h3>
          <p>Customer active in our site</p>
        </div>
      </div>
      <div class="col-md-3 col-6 mb-4">
        <div class="p-4 border rounded shadow-sm">
          <h3 class="fw-bold">25k</h3>
          <p>Annual gross sale in our site</p>
        </div>
      </div>
    </div>

    <!-- Features Section -->
    <div class="row text-center">
      <div class="col-md-4 mb-4">
        <i class="fas fa-truck fa-2x mb-3 text-primary"></i>
        <h5>FREE AND FAST DELIVERY</h5>
        <p>Free delivery for all orders over INR 300</p>
      </div>
      <div class="col-md-4 mb-4">
        <i class="fas fa-headset fa-2x mb-3 text-primary"></i>
        <h5>CUSTOMER SUPPORT</h5>
        <p>Sunday to Friday, 9:00–17:00</p>
      </div>
      <div class="col-md-4 mb-4">
        <i class="fas fa-money-bill-wave fa-2x mb-3 text-primary"></i>
        <h5>MONEY BACK GUARANTEE</h5>
        <p>We return money within 30 days</p>
      </div>
    </div>
  </div>
</main>


  <!--  Footer (to be imported) -->
   <%- include('footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

