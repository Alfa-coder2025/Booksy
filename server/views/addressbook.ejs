<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Address Book - Online Bookstore</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/app.css" rel="stylesheet" type="text/css" />
    <script src="/js/main/addressbook.js"></script>
</head>
<body>

  <!-- Navbar (imported) -->
  <%- include('navbar') %>

  <div class="container my-5">
    <!-- Breadcrumb -->
    <nav style="--bs-breadcrumb-divider: '>'; font-size:14px;" aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item">Account</li>
        <li class="breadcrumb-item active" aria-current="page">Address Book</li>
      </ol>
    </nav>

    <div class="row">
      <!-- Sidebar -->
      <div class="col-md-3">
        <div class="card shadow-sm p-3">
          <ul class="nav flex-column">
            <li class="nav-item"><a class="nav-link" href="/account/profile">My Profile</a></li>
            <li class="nav-item"><a class="nav-link active" href="/account/address">Address Book</a></li>
            <li class="nav-item"><a class="nav-link" href="/account/orders">My Orders</a></li>
            <li class="nav-item"><a class="nav-link" href="/account/wishlist">My Wishlist</a></li>
            <li class="nav-item"><a class="nav-link" href="/account/wallet">Wallet</a></li>
            <li class="nav-item"><a class="nav-link" href="/account/coupons">Coupons</a></li>
          </ul>
        </div>
      </div>

      <!-- Main Content -->
      <div class="col-md-9">
        <div class="card shadow-sm p-4">
          <h5 class="mb-4">Here you can manage your addresses</h5>

          <!-- Dynamic Address List -->
          <div id="addressList">
            <!-- JS will inject address cards here -->
          </div>

          <!-- Add Address Button -->
          <div class="mt-4">
            <button id="addAddressBtn" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addressModal">
              Add New Address
            </button>
          </div>

        </div>
      </div>
    </div>
  </div>

  <!-- Address Modal (for Add/Edit) -->
  <div class="modal fade" id="addressModal" tabindex="-1" aria-labelledby="addressModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <form id="addressForm">
          <div class="modal-header">
            <h5 class="modal-title" id="addressModalLabel">Add New Address</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            
            <!-- Hidden input to track edit -->
            <input type="hidden" id="addressId">

            <div class="mb-3">
              <label for="name" class="form-label">Full Name</label>
              <input type="text" class="form-control" id="name" required>
            </div>

            <div class="mb-3">
              <label for="house" class="form-label">House / Street</label>
              <input type="text" class="form-control" id="house" required>
            </div>

            <div class="mb-3">
              <label for="place" class="form-label">Place</label>
              <input type="text" class="form-control" id="place" required>
            </div>

            <div class="mb-3">
              <label for="pincode" class="form-label">Pincode</label>
              <input type="text" class="form-control" id="pincode" required>
            </div>

            <div class="mb-3">
              <label for="contact" class="form-label">Contact</label>
              <input type="text" class="form-control" id="contact" required>
            </div>

          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Save Address</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Footer (imported) -->
  <%- include('footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/addressBook.js"></script>
</body>
</html>
