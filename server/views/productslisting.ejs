         <div class="border rounded p-3">
  <h5 class="mb-3">Filters</h5>
  <h6 class="fw-bold">By Category</h6>
  <div id="categoryFilters">
    <!-- Dynamic checkboxes will be added here -->
  </div>
</div>

        
         <div class="border rounded p-3" id="priceFilters">
       
          <h6 class="fw-bold">By Price</h6>
          <div class="form-check">
            <input class="form-check-input price-filter" type="checkbox" id="priceupto499">
            <label class="form-check-label" for="priceupto499">Upto 499</label>
          </div>
          <div class="form-check">
            <input class="form-check-input price-filter" type="checkbox" id="price500to1000">
            <label class="form-check-label" for="price500to1000">500 to 1000</label>
          </div>
          <div class="form-check">
            <input class="form-check-input price-filter" type="checkbox" id="price1000to2000">
            <label class="form-check-label" for="price1001to2000">1001-2000</label>
          </div>
          <div class="form-check">
            <input class="form-check-input price-filter" type="checkbox" id="priceabove2000">
            <label class="form-check-label" for="priceabove2000">above 2000</label>
          </div>
        </div>
      </aside>

      <!-- Main Product Section -->
   
