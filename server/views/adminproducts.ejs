
<!DOCTYPE html>
<html lang="en">
<head>
  <head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Users</title>
  
  <link rel="stylesheet" href="/css/admin.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  
</head>

<body>


   <div class="container-fluid">
    <div class="row">
      <div class="col-md-2">
        <%- include('sidebar') %>
      </div>
      <div class="col-md-10 content-area">
        <h3>Products</h3>
<!-- Filter -->
<div class="filter-box d-flex align-items-center gap-3 flex-wrap bg-white p-3 rounded shadow-sm" id="filter-products">
  <div class="d-flex align-items-center gap-2">
    <button class="btn btn-light border"><i class="fas fa-filter"></i></button>
    <span>Filter By</span>
  </div>
  <div>
    <select class="form-select" id="sortDropdown">
      <option value="all" selected>Sort</option>
      <option value="latest">Latest</option>
      <option value="oldest">Oldest</option>
    </select>
  </div>
  <div>
    <select class="form-select" id="categoryDropdown">
      <option  value="all" selected>Category</option>
      <!-- categories will be filled dynamically by JS -->
      </select>
  </div>
  <div class="ms-auto">
    <a href="/admin-addproducts" class="btn btn-primary">
      <i class="fas fa-plus me-2"></i> Add New Product
    </a>
  </div>
</div>

<!--search bar-->

          <div class="input-group mb-3 mt-3">
  <input type="text" id="productSearch" class="form-control" placeholder="Search Books by name  or category">
  <button class="btn btn-outline-secondary" type="button" id="clearProductSearch">Clear</button>
</div>

<!-- Products Table -->
<table class="table table-hover mt-4 align-middle bg-white rounded shadow-sm overflow-hidden" id="products-table-body">
  <thead class="table-light">
    <tr>
      <th>Image</th>
     <th class="sortable-product" data-sort="bookName">Product Name</th>
      <th>Category</th>
      <th>Author</th>
      <th>Price</th>
      <th>Stock</th>
      <th>Top Selling</th>
      <th>Latest</th>
      <th class="text-center">Action</th>
    </tr>
  </thead>
 <tbody id="productTableBody">
</tbody>

</table>

<!-- Image Preview Modal -->
<div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Book Image</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body text-center">
        <img id="previewImage" src="" alt="Book Image" class="img-fluid rounded">
      </div>
    </div>
  </div>
</div>

<!--page sizing-->
 <div>
    <label for="pageSize" class="me-2">Rows per page:</label>
    <select id="pageSize" class="form-select form-select-sm d-inline-block" style="width: auto;">
      <option value="3">3</option>
      <option value="5">5</option>
      <option value="10">10</option>
    </select>
  </div>

<!-- Pagination Controls -->
      <nav>
        <ul id="pagination" class="pagination"></ul>
      </nav>

      <!--edit modal-->

<div class="modal fade" id="editProductModal" tabindex="-1" aria-labelledby="editProductModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold" id="editProductModalLabel">Edit Product</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <!-- Edit form -->
      <form id="edit-product-form" enctype="multipart/form-data">
        <input type="hidden" name="productId" id="editProductId">

        <div class="modal-body">
          <div class="row g-5">
            <!-- Left side -->
            <div class="col-md-7">
              <div class="mb-3">
                <label class="form-label fw-bold">Product Name</label>
                <input type="text" class="form-control" name="bookName" id="editBookName">
              </div>

              <div class="mb-3">
                <label class="form-label fw-bold">Author</label>
                <input type="text" id="editAuthor" name="author" class="form-control" placeholder="Enter author">
              </div>

              <div class="mb-3">
                <label class="form-label fw-bold">Description</label>
                <textarea class="form-control" rows="4" name="description" id="editDescription"></textarea>
              </div>

              <div class="mb-3">
                <label class="form-label fw-bold">Offer</label>
                <input type="text" class="form-control" name="offer" id="editOffer">
              </div>

              <div class="mb-3">
                <label class="form-label fw-bold">Stock Quantity</label>
                <input type="number" class="form-control" name="stockQuantity" id="editStockQuantity">
              </div>

              <div class="row mb-3">
                <div class="col">
                  <label class="form-label fw-bold">Regular Price</label>
                  <input type="text" class="form-control" name="regularPrice" id="editRegularPrice">
                </div>
                <div class="col">
                  <label class="form-label fw-bold">Sale Price</label>
                  <input type="text" class="form-control" name="salePrice" id="editSalePrice">
                </div>
              </div>


              <!-- Toggles -->
             <div class="row mb-3">
  <div class="col">
    <label for="showAsTopSelling" class="form-label fw-bold">Show as Top Selling</label>
    <div class="form-check form-switch">
     
   
      <input class="form-check-input" type="checkbox" id="showAsTopSelling" name="showAsTopSelling" value="true">
      <label class="form-check-label" for="showAsTopSelling"></label>
    </div>
  </div>

  <div class="col">
    <label for="showAsLatest" class="form-label fw-bold">Show as Latest</label>
    <div class="form-check form-switch">
   
      <input class="form-check-input" type="checkbox" id="showAsLatest" name="showAsLatest" value="true">
      <label class="form-check-label" for="showAsLatest"></label>
    </div>
  </div>
</div>


              <!-- Category dropdown -->
              <div class="mb-4">
                <label class="form-label fw-bold">Category</label>
                <select class="form-select" name="categoryId" id="editCategoryDropdown">
                  <option value="">Select a Category</option>
                </select>
              </div>

              <!-- File upload with preview -->
              <div class="mb-3">
                <label class="form-label fw-bold">Book Cover</label><br>
                <img id="editBookCoverPreview" src="/images/no-image.png" alt="Book Cover Preview" 
                     style="max-width: 120px; margin-bottom: 10px; display:block;">
                <input type="file" name="images" id="editBookCover" class="form-control" accept="image/*">
              </div>
            </div>
          </div>
        </div>

        <!-- Footer inside form -->
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="submit" class="btn btn-primary">Update</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script src="/js/main/pagination.js"></script>
<script src="/js/main/adminproducts.js"></script>

</body>
</html>