<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
  <title>Admin Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/admin.css" />
    <script src="/js/main/admindashboard.js"></script>
</head>
<body>
  <div class="d-flex">
    <!-- Sidebar -->
    <%- include("sidebar") %>

    <!-- Main -->
    <main class="flex-fill p-4 bg-light">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Dashboard</h3>
        <input class="form-control w-25" type="search" placeholder="Search..." />
      </div>

      <!-- Summary Cards -->
      <div class="row g-3 mb-4">
        <div class="col-md-4">
          <div class="card card-summary">
            <div class="card-body">
              <p>Total User</p>
              <h4 id="totalUsers"></h4>
              <p class="text-success" id="usersTrend"></p>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card card-summary">
            <div class="card-body">
              <p>Total Order</p>
              <h4 id="totalOrders"></h4>
              <p class="text-success" id="ordersTrend"></p>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card card-summary">
            <div class="card-body">
              <p>Total Sales</p>
              <h4 id="totalSales"></h4>
              <p class="text-danger" id="salesTrend"></p>
            </div>
          </div>
        </div>
      </div>

      <!-- Sales Graph Placeholder -->
      <!--
      <div class="card p-3 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h5>Sales Details</h5>
          <div>
            <select class="form-select d-inline w-auto me-2">
              <option selected>Today</option>
              <option>Yesterday</option>
            </select>
            <select class="form-select d-inline w-auto">
              <option selected>October</option>
              <option>September</option>
            </select>
          </div>
        </div>
        <div style="height: 250px; background: #f6f8fc;" class="d-flex justify-content-center align-items-center text-muted">
          Graph Placeholder
        </div>
      </div>
      -->

      <!-- Table -->
      <div class="table-responsive card p-3">
        <table class="table align-middle" id="ordersTableBody">
          <thead>
            <tr>
              <th>ID</th>
              <th>NAME</th>
              <th>ADDRESS</th>
              <th>DATE</th>
              <th>TYPE</th>
              <th>STATUS</th>
            </tr>
          </thead>
          <tbody>
            <!-- Rows will be dynamically inserted here -->
          </tbody>
        </table>
      </div>
    </main>
  </div>
  <script>
  window.history.pushState(null, "", window.location.href);
  window.onpopstate = function () {
    window.history.pushState(null, "", window.location.href);
  };
   window.addEventListener("pageshow", function (event) {
    if (event.persisted) {
      window.location.reload(); // reload from server, not cache
    }
  });
</script>
</body>

</html>
